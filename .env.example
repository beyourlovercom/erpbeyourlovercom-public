APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
AUTH_REMEMBER_DURATION=43200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2.0
REDIS_READ_TIMEOUT=6.0
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_BLOCK_FOR=5
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Blue Label Worker — machine-to-machine execution only.
# Production token must be generated and injected through the deployment secret store.
BLUE_LABEL_WORKER_TOKEN=
BLUE_LABEL_WORKER_LEASE_SECONDS=180
BLUE_LABEL_WORKER_MAX_ATTEMPTS=3
BLUE_LABEL_WORKER_RETRY_BASE_SECONDS=30

VITE_APP_NAME="${APP_NAME}"

ERP_LOCAL_ADMIN_BYPASS=false
ERP_LOCAL_ADMIN_EMAIL=test@example.com

WOO_BASE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_CONNECTION_KEY=beyourlover.com
WOO_TIMEOUT_SECONDS=15
WOO_PRODUCT_SYNC_ENABLED=false
WOO_MEDIA_ALLOWED_HOSTS=

# Finance historical Woo settlement bootstrap. Keep false unless Owner approves Production apply.
ERP_ACCOUNTING_FINANCIAL_BOOTSTRAP_PRODUCTION_APPLY_ENABLED=false

# Andy Core / AffiliateWP connector
ANDY_CORE_URL=
ANDY_CORE_CONNECTION_KEY=beyourlover.com
ANDY_CORE_KEY_ID=
ANDY_CORE_SHARED_SECRET=
ANDY_CORE_TIMEOUT_SECONDS=15
ANDY_CORE_CONNECT_TIMEOUT_SECONDS=5
ANDY_CORE_RETRY_TIMES=2
ANDY_CORE_RETRY_SLEEP_MS=500
# Local/testing only. Never enable for production or use as live-provider evidence.
ANDY_CORE_UAT_FAKE=false
